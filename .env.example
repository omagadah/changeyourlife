# Variables d'environnement - changeyourlife.ai (Vercel, projet banzays-projects)
# Aucune valeur ici. Copier dans Vercel > Settings > Environment Variables.

# Firebase Admin (JSON du compte de service, sur une ligne)
FIREBASE_SERVICE_ACCOUNT=

# CYL (chat + brief) - Anthropic. Un des deux noms suffit.
API_ANTHROPIC_CHATBOT=
# ANTHROPIC_API_KEY=
# Optionnel : epingler un modele, ou choisir la famille (defaut : haiku). Cf. api/_models.js
# ANTHROPIC_MODEL=
# ANTHROPIC_FAMILY=haiku

# Traduction (api/translate.js) - les modeles sont resolus via l'annuaire du fournisseur
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=
# GEMINI_MODEL=

# Email transactionnel (verification, alertes)
RESEND_API_KEY=

# Controle de sante quotidien (api/health.js) : chaine aleatoire, exigee sur chaque appel
CRON_SECRET=
# Boite qui recoit les alertes de panne (sinon noreply@, c'est-a-dire personne)
ALERT_EMAIL=

# Cloud Functions (functions/) : bootstrap du premier admin, a retirer une fois le claim pose
# ROOT_ADMIN_UID=
